{% extends 'base.html.twig' %}{% set jours = {1:'Lundi',2:'Mardi',3:'Mercredi',4:'Jeudi',5:'Vendredi',6:'Samedi',7:'Dimanche'} %}{% block body %}<p class="eyebrow">HORAIRES</p>{% if page == 'types' %}<h1>Types horaires</h1><section class="card"><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="type"><label>Nouveau type<input name="nom" required maxlength="100" placeholder="Normal, Quart A…"></label><button>Ajouter</button></form></section><section class="card"><h2>Types existants</h2><ul>{% for t in types %}<li>{{ t.nom }}</li>{% else %}<li>Aucun type horaire.</li>{% endfor %}</ul></section>{% elseif page == 'plages' %}<h1>Plage hebdomadaire</h1><section class="card"><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="plage"><label>Type<select name="type_horaire_id">{% for t in types %}<option value="{{ t.id }}">{{ t.nom }}</option>{% endfor %}</select></label><label>Jour de début<select name="jour">{% for id,jour in jours %}<option value="{{ id }}">{{ jour }}</option>{% endfor %}</select></label><div class="grid"><label>Début<input type="time" name="debut" required></label><label>Fin<input type="time" name="fin" required></label></div><button>Ajouter la plage</button><p class="muted">Si la fin est antérieure ou égale au début, la plage finit le lendemain. Début inclus, fin exclue ; 00:00 à 00:00 = 24 heures.</p></form></section>{% elseif page == 'affectations' %}<h1>Affecter un travailleur à une période</h1><section class="card"><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="affectation"><label>Employé<select name="employe_id">{% for e in employes %}<option value="{{ e.id }}">{{ e.matricule }} · {{ e.nom }} {{ e.prenoms }}</option>{% endfor %}</select></label><label>Type<select name="type_horaire_id">{% for t in types %}<option value="{{ t.id }}">{{ t.nom }}</option>{% endfor %}</select></label><label>Du<input type="date" name="date_debut" required></label><label>Au (vide = sans fin)<input type="date" name="date_fin"></label><button>Affecter</button></form></section>{% else %}<h1>Déclarer une absence</h1><section class="card"><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="absence"><label>Employé<select name="employe_id">{% for e in employes %}<option value="{{ e.id }}">{{ e.matricule }} · {{ e.nom }} {{ e.prenoms }}</option>{% endfor %}</select></label><label>Début<input name="debut" type="datetime-local" required></label><label>Fin<input name="fin" type="datetime-local" required></label><label>Motif<input name="motif" maxlength="150" required></label><button>Enregistrer l’absence</button></form></section>{% endif %}<p><a href="{{ path('horaires') }}">← Horaires et périodes de travail</a></p>{% endblock %}
