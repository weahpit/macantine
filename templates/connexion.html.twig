{% extends 'base.html.twig' %}{% block body %}<section class="login card"><img class="login-logo" src="{{ branding.logoPath ? path('logo_public') : app.request.basePath ~ '/logo-defaut.svg' }}" alt="Logo" width="96" height="96"><p class="eyebrow">ESPACE SÉCURISÉ</p><h1>Bienvenue à la cantine</h1><p>Connectez-vous pour accéder à votre espace.</p>{% if error %}<div class="alert error">Connexion refusée. Vérifiez vos identifiants ou réessayez plus tard.</div>{% endif %}<form method="post" action="{{ path('connexion') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><label>Adresse e-mail<input name="_username" type="email" value="{{ last }}" required autocomplete="username"></label><label>Mot de passe<input name="_password" type="password" required autocomplete="current-password"></label><button>Se connecter</button></form></section>{% endblock %}
