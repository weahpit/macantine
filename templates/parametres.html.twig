{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">CONFIGURATION</p><h1>Organisation et repas</h1><div class="two">{% if app.user.role in ['ROLE_ADMIN','ROLE_RH'] %}<section class="card"><h2>Directions</h2><ul>{% for d in directions %}<li>{{ d.nom }}</li>{% else %}<li>Aucune direction</li>{% endfor %}</ul><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('parametres') }}"><input name="nature" type="hidden" value="direction"><label>Nouvelle direction<input name="nom" maxlength="100" required></label><button>Ajouter</button></form></section><section class="card"><h2>Services</h2><ul>{% for s in services %}<li>{{ s.direction_nom }} · {{ s.nom }}</li>{% else %}<li>Aucun service</li>{% endfor %}</ul><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('parametres') }}"><input name="nature" type="hidden" value="service"><label>Direction<select name="direction_id" required>{% for d in directions %}<option value="{{ d.id }}">{{ d.nom }}</option>{% endfor %}</select></label><label>Nouveau service<input name="nom" maxlength="100" required></label><button>Ajouter</button></form></section>{% endif %}</div><section class="card"><h2>Types de repas</h2>{% for t in types %}{% if app.user.role in ['ROLE_ADMIN','ROLE_CANTINE'] %}<form method="post" class="filters"><input name="_token" type="hidden" value="{{ csrf_token('parametres') }}"><input name="nature" type="hidden" value="repas"><input name="id" type="hidden" value="{{ t.id }}"><label>Libellé<input name="nom" value="{{ t.nom }}" maxlength="100" required></label><label class="check"><input type="checkbox" name="actif" value="1" {% if t.actif %}checked{% endif %}>Actif</label><button class="secondary">Enregistrer</button></form>{% else %}<p>{{ t.nom }} · {{ t.actif ? 'Actif' : 'Inactif' }}</p>{% endif %}{% endfor %}{% if app.user.role in ['ROLE_ADMIN','ROLE_CANTINE'] %}<h3>Ajouter un type</h3><form method="post" class="filters"><input name="_token" type="hidden" value="{{ csrf_token('parametres') }}"><input name="nature" type="hidden" value="repas"><label>Nom<input name="nom" maxlength="100" required></label><label class="check"><input type="checkbox" name="actif" value="1" checked>Actif</label><button>Ajouter</button></form>{% endif %}</section>{% endblock %}
