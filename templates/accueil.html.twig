{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">SUIVI GLOBAL · {{ today|date('d/m/Y') }}</p><h1>Tableau de bord</h1><p>Les sept derniers jours. Les tickets délivrés ne sont pas des recettes : le paiement intervient à la cantine.</p><div class="metrics"><section class="card"><span>Tickets délivrés sur 7 jours</span><strong>{{ report.totaux.tickets }}</strong></section><section class="card"><span>Tickets disponibles, toutes dates</span><strong>{{ disponibles }}</strong></section><section class="card"><span>Repas servis sur 7 jours</span><strong>{{ report.totaux.repas }}</strong></section><section class="card"><span>Encaissé à la cantine</span><strong>{{ report.totaux.encaisse|number_format(0,',',' ') }} F</strong></section></div><h2 class="section-title">Plats du jour · {{ today|date('d/m/Y') }}</h2>{% if platsJour %}<div class="dish-grid">{% for p in platsJour %}{% include '_plat.html.twig' with {p:p} %}{% endfor %}</div>{% else %}<section class="card"><p>Aucun plat programmé aujourd’hui. <a href="{{ path('menus') }}">Configurer les menus</a>.</p></section>{% endif %}<section class="card"><h2>Encaissements quotidiens — FCFA</h2><div class="chart"><svg viewBox="0 0 770 280" role="img" aria-label="Encaissements des sept derniers jours"><line x1="30" y1="220" x2="755" y2="220" stroke="#b9c9be"/>{% for point in series %}{% set height = 165 * point.montant / max %}<rect x="{{ 50 + loop.index0 * 100 }}" y="{{ 220 - height }}" width="55" height="{{ height }}" fill="#395c4c" rx="5"/><text x="{{ 77 + loop.index0 * 100 }}" y="{{ 205 - height }}" text-anchor="middle" font-size="14" fill="#263c33">{{ point.montant }}</text><text x="{{ 77 + loop.index0 * 100 }}" y="245" text-anchor="middle" font-size="13" fill="#5f7067">{{ point.date|date('d/m') }}</text><text x="{{ 77 + loop.index0 * 100 }}" y="266" text-anchor="middle" font-size="11" fill="#5f7067">{{ point.repas }} repas</text>{% endfor %}</svg></div><p class="muted">Subvention théorique sur les repas servis : {{ report.totaux.subvention|number_format(0,',',' ') }} F. Elle n’est pas un encaissement de l’employeur.</p></section>{% endblock %}
