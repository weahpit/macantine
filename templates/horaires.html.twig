{% extends 'base.html.twig' %}{% set jours = {1:'Lundi',2:'Mardi',3:'Mercredi',4:'Jeudi',5:'Vendredi',6:'Samedi',7:'Dimanche'} %}{% block body %}<p class="eyebrow">TRAVAILLEURS EN ACTIVITÉ</p><h1>Horaires et périodes de travail</h1><p>Un salarié doit être actif, affecté à un type horaire sur la date concernée et dans une plage autorisée, sans absence déclarée. Aucun horaire n’est activé automatiquement.</p><div class="two"><section class="card"><h2>Types horaires</h2><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="type"><label>Nouveau type<input name="nom" required placeholder="Normal, Quart A…"></label><button>Ajouter</button></form><ul>{% for t in types %}<li>{{ t.nom }}</li>{% endfor %}</ul></section><section class="card"><h2>Ajouter une plage hebdomadaire</h2><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="plage"><label>Type<select name="type_horaire_id">{% for t in types %}<option value="{{ t.id }}">{{ t.nom }}</option>{% endfor %}</select></label><label>Jour de début<select name="jour">{% for id,jour in jours %}<option value="{{ id }}">{{ jour }}</option>{% endfor %}</select></label><div class="grid"><label>Début<input type="time" name="debut" required></label><label>Fin<input type="time" name="fin" required></label></div><button>Ajouter la plage</button><p class="muted">Si la fin est antérieure ou égale au début, la plage finit le lendemain. Début inclus, fin exclue ; 00:00 à 00:00 = 24 heures.</p></form></section><section class="card"><h2>Affecter un travailleur à une période</h2><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="affectation"><label>Employé<select name="employe_id">{% for e in employes %}<option value="{{ e.id }}">{{ e.matricule }} · {{ e.nom }} {{ e.prenoms }}</option>{% endfor %}</select></label><label>Type<select name="type_horaire_id">{% for t in types %}<option value="{{ t.id }}">{{ t.nom }}</option>{% endfor %}</select></label><label>Du<input type="date" name="date_debut" required></label><label>Au (vide = sans fin)<input type="date" name="date_fin"></label><button>Affecter</button></form></section><section class="card"><h2>Déclarer une absence</h2><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="absence"><label>Employé<select name="employe_id">{% for e in employes %}<option value="{{ e.id }}">{{ e.matricule }} · {{ e.nom }}</option>{% endfor %}</select></label><label>Début<input name="debut" type="datetime-local" required></label><label>Fin<input name="fin" type="datetime-local" required></label><label>Motif<input name="motif" maxlength="150" required></label><button>Enregistrer l’absence</button></form></section></div><section class="card"><h2>Plages programmées</h2><div class="table"><table><tr><th>Type</th><th>Jour</th><th>Heures</th><th>Action</th></tr>{% for p in plages %}<tr><td>{{ p.type_nom }}</td><td>{{ jours[p.jour] }}</td><td>{{ p.debut }} → {{ p.fin }}</td><td><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="supprimer_plage"><input name="id" type="hidden" value="{{ p.id }}"><button class="secondary">Supprimer</button></form></td></tr>{% endfor %}</table></div></section><section class="card"><h2>Affectations</h2><div class="table"><table><tr><th>Employé</th><th>Type</th><th>Période</th><th>Action</th></tr>{% for a in affectations %}<tr><td>{{ a.matricule }} · {{ a.nom }} {{ a.prenoms }}</td><td>{{ a.type_nom }}</td><td>{{ a.date_debut }} → {{ a.date_fin|default('Sans fin',true) }}</td><td><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="supprimer_affectation"><input name="id" type="hidden" value="{{ a.id }}"><button class="secondary">Supprimer</button></form></td></tr>{% endfor %}</table></div></section><section class="card"><h2>Absences</h2><div class="table"><table><tr><th>Employé</th><th>Période</th><th>Motif</th><th>Action</th></tr>{% for a in absences %}<tr><td>{{ a.matricule }} · {{ a.nom }}</td><td>{{ a.debut }} → {{ a.fin }}</td><td>{{ a.motif }}</td><td><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="supprimer_absence"><input name="id" type="hidden" value="{{ a.id }}"><button class="secondary">Supprimer</button></form></td></tr>{% endfor %}</table></div></section>{% endblock %}
