{% extends 'base.html.twig' %}{% set jours = {1:'Lundi',2:'Mardi',3:'Mercredi',4:'Jeudi',5:'Vendredi',6:'Samedi',7:'Dimanche'} %}{% block body %}<p class="eyebrow">TRAVAILLEURS EN ACTIVITÉ</p><h1>Horaires et périodes de travail</h1><p>Un salarié doit être actif, affecté à un type horaire sur la date concernée et dans une plage autorisée, sans absence déclarée. Aucun horaire n’est activé automatiquement.</p><div class="actions"><a class="button" href="{{ path('horaires_types') }}">Types horaires</a><a class="button" href="{{ path('horaires_plages') }}">Plage hebdomadaire</a><a class="button" href="{{ path('horaires_affectations') }}">Affecter un travailleur</a><a class="button" href="{{ path('horaires_absences') }}">Déclarer une absence</a></div>
<section class="card"><details open><summary>Plages programmées ({{ plages|length }})</summary><div class="table"><table><tr><th>Type</th><th>Jour</th><th>Heures</th><th>Action</th></tr>{% for p in plages %}<tr><td>{{ p.type_nom }}</td><td>{{ jours[p.jour] }}</td><td>{{ p.debut }} → {{ p.fin }}</td><td><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="supprimer_plage"><input name="id" type="hidden" value="{{ p.id }}"><button class="secondary">Supprimer</button></form></td></tr>{% else %}<tr><td colspan="4">Aucune plage programmée.</td></tr>{% endfor %}</table></div></details></section>
<section class="card"><details open><summary>Affectations ({{ affectations|length }})</summary><div class="table"><table><tr><th>Employé</th><th>Type</th><th>Période</th><th>Action</th></tr>{% for a in affectations %}<tr><td>{{ a.matricule }} · {{ a.nom }} {{ a.prenoms }}</td><td>{{ a.type_nom }}</td><td>{{ a.date_debut }} → {{ a.date_fin|default('Sans fin',true) }}</td><td><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="supprimer_affectation"><input name="id" type="hidden" value="{{ a.id }}"><button class="secondary">Supprimer</button></form></td></tr>{% else %}<tr><td colspan="4">Aucune affectation.</td></tr>{% endfor %}</table></div></details></section>
<section class="card"><details open><summary>Absences ({{ absences|length }})</summary><div class="table"><table><tr><th>Employé</th><th>Période</th><th>Motif</th><th>Action</th></tr>{% for a in absences %}<tr><td>{{ a.matricule }} · {{ a.nom }}</td><td>{{ a.debut }} → {{ a.fin }}</td><td>{{ a.motif }}</td><td><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('horaires') }}"><input name="nature" type="hidden" value="supprimer_absence"><input name="id" type="hidden" value="{{ a.id }}"><button class="secondary">Supprimer</button></form></td></tr>{% else %}<tr><td colspan="4">Aucune absence déclarée.</td></tr>{% endfor %}</table></div></details></section>{% endblock %}
