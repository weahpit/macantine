<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{% block title %}Cantine · Tickets et encaissements{% endblock %}</title><link rel="icon" href="{{ app.request.basePath }}/logo-defaut.svg" type="image/svg+xml"><link rel="stylesheet" href="{{ app.request.basePath }}/style.css">{% block stylesheets %}{% endblock %}</head><body class="{% block body_class %}{% endblock %}"><header class="top"><a class="brand" href="{{ path('accueil') }}"><img class="brand-logo" src="{{ branding.logoPath ? path('logo_public') : app.request.basePath ~ '/logo-defaut.svg' }}" alt="" width="46" height="46"><span class="brand-name">MA CANTINE<small>Tickets · Repas · Finances</small></span></a>{% if app.user %}<div class="identity">{{ app.user.nom }}<form action="{{ path('deconnexion') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="secondary">Déconnexion</button></form></div>{% endif %}</header>{% if app.user %}<nav><a href="{{ path('accueil') }}">Tableau de bord</a><a href="{{ path('tickets') }}">{{ app.user.role == 'ROLE_EMPLOYE' ? 'Mes tickets' : 'Tickets' }}</a><a href="{{ path('menus') }}">Menus</a>{% if app.user.role in ['ROLE_ADMIN','ROLE_RH'] %}<a href="{{ path('employes') }}">Employés</a><details class="dd"><summary>Horaires</summary><div class="submenu"><a href="{{ path('horaires') }}">Vue d’ensemble</a><a href="{{ path('horaires_types') }}">Types horaires</a><a href="{{ path('horaires_plages') }}">Plage hebdomadaire</a><a href="{{ path('horaires_affectations') }}">Affecter un travailleur</a><a href="{{ path('horaires_absences') }}">Déclarer une absence</a></div></details><details class="dd"><summary>Organisation</summary><div class="submenu"><a href="{{ path('org_directions') }}">Directions</a><a href="{{ path('org_services') }}">Services</a><a href="{{ path('org_types') }}">Types de repas</a></div></details>{% endif %}{% if app.user.role in ['ROLE_ADMIN','ROLE_CANTINE'] %}<a href="{{ path('controle') }}">Contrôle / caisse</a><a href="{{ path('plats') }}">Plats / tarifs</a>{% endif %}{% if app.user.role == 'ROLE_CANTINE' %}<a href="{{ path('org_types') }}">Types de repas</a>{% endif %}{% if app.user.role in ['ROLE_ADMIN','ROLE_RH','ROLE_COMPTABILITE'] %}<a href="{{ path('statistiques') }}">États / exports</a>{% endif %}{% if app.user.role == 'ROLE_ADMIN' %}<a href="{{ path('societe') }}">Société</a><a href="{{ path('utilisateurs') }}">Utilisateurs</a><a href="{{ path('journal') }}">Journal</a>{% endif %}{% if app.user.role == 'ROLE_EMPLOYE' and app.user.employeId %}<a href="{{ path('badge',{id:app.user.employeId}) }}">Mon badge</a>{% endif %}</nav>{% endif %}<main>{% for kind,messages in app.flashes %}{% for message in messages %}<div class="alert {{ kind }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main><footer>Un ticket délivré par jour · Paiement à la cantine · Contrôle des horaires de travail.</footer></body></html>
