{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">ORGANISATION</p>{% if page == 'directions' %}<h1>Directions</h1><section class="card"><ul>{% for d in directions %}<li>{{ d.nom }}</li>{% else %}<li>Aucune direction</li>{% endfor %}</ul><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('parametres') }}"><input name="nature" type="hidden" value="direction"><label>Nouvelle direction<input name="nom" maxlength="100" required></label><button>Ajouter</button></form></section>{% elseif page == 'services' %}<h1>Services</h1><section class="card"><ul>{% for s in services %}<li>{{ s.direction_nom }} · {{ s.nom }}</li>{% else %}<li>Aucun service</li>{% endfor %}</ul><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('parametres') }}"><input name="nature" type="hidden" value="service"><label>Direction<select name="direction_id" required>{% for d in directions %}<option value="{{ d.id }}">{{ d.nom }}</option>{% endfor %}</select></label><label>Nouveau service<input name="nom" maxlength="100" required></label><button>Ajouter</button></form></section>{% else %}<h1>Types de repas</h1><section class="card">{% for t in types %}{% if app.user.role in ['ROLE_ADMIN','ROLE_CANTINE'] %}<form method="post" class="filters"><input name="_token" type="hidden" value="{{ csrf_token('parametres') }}"><input name="nature" type="hidden" value="repas"><input name="id" type="hidden" value="{{ t.id }}"><label>Libellé<input name="nom" value="{{ t.nom }}" maxlength="100" required></label><label class="check"><input type="checkbox" name="actif" value="1" {% if t.actif %}checked{% endif %}>Actif</label><button class="secondary">Enregistrer</button></form>{% else %}<p>{{ t.nom }} · {{ t.actif ? 'Actif' : 'Inactif' }}</p>{% endif %}{% endfor %}{% if app.user.role in ['ROLE_ADMIN','ROLE_CANTINE'] %}<h3>Ajouter un type</h3><form method="post" class="filters"><input name="_token" type="hidden" value="{{ csrf_token('parametres') }}"><input name="nature" type="hidden" value="repas"><label>Nom<input name="nom" maxlength="100" required></label><label class="check"><input type="checkbox" name="actif" value="1" checked>Actif</label><button>Ajouter</button></form>{% endif %}</section>{% endif %}{% endblock %}
