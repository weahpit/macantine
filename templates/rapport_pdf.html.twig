<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>body{font-family:DejaVu Sans,sans-serif;font-size:9px;color:#263c33}h1{font-size:20px}h2{font-size:13px}table{width:100%;border-collapse:collapse;margin-bottom:16px}th,td{padding:5px;border:1px solid #dbe3dc}th{background:#e8efea}thead{display:table-header-group}tr{page-break-inside:avoid}.head{border:0;margin-bottom:10px}.head td{border:0;vertical-align:middle}.hl{width:90px}.co{font-size:14px}tfoot th{background:#e8efea}</style></head><body><table class="head"><tr>{% if logo %}<td class="hl"><img src="{{ logo }}" height="52" alt=""></td>{% endif %}<td><strong class="co">{{ societe.nom|default('MA CANTINE',true) }}</strong>{% if societe.adresse %}<br>{{ societe.adresse|nl2br }}{% endif %}{% if societe.telephone %}<br>Tél. : {{ societe.telephone }}{% endif %}{% if societe.email %}<br>{{ societe.email }}{% endif %}{% if societe.identifiant_fiscal %}<br>{{ societe.identifiant_fiscal }}{% endif %}</td></tr></table><h1>État cantine — {{ report.debut }} au {{ report.fin }}</h1><p>Tickets délivrés : {{ report.totaux.tickets }} · Repas encaissés : {{ report.totaux.repas }} · Encaissement employé : {{ report.totaux.encaisse }} FCFA · Subvention théorique : {{ report.totaux.subvention }} FCFA · Valeur publique : {{ report.totaux.public }} FCFA.</p><p>La subvention n’est pas un encaissement employeur. Tickets par date de délivrance ; paiements par date d’encaissement. Les critères de filtrage ont été appliqués avant génération.</p><h2>Montants par jour et cumul</h2><table><thead><tr><th>Jour</th><th>Tickets</th><th>Repas</th><th>Encaissé</th><th>Subvention</th><th>Valeur publique</th><th>Cumul repas</th><th>Cumul encaissé</th><th>Cumul subvention</th></tr></thead><tbody>{% for j in report.jours %}<tr><td>{{ j.jour|date('d/m/Y') }}</td><td>{{ j.tickets_delivres }}</td><td>{{ j.repas_servis }}</td><td>{{ j.encaisse_fcfa|number_format(0,',',' ') }}</td><td>{{ j.subvention_fcfa|number_format(0,',',' ') }}</td><td>{{ j.valeur_publique_fcfa|number_format(0,',',' ') }}</td><td>{{ j.cumul_repas }}</td><td>{{ j.cumul_encaisse_fcfa|number_format(0,',',' ') }}</td><td>{{ j.cumul_subvention_fcfa|number_format(0,',',' ') }}</td></tr>{% else %}<tr><td colspan="9">Aucune activité.</td></tr>{% endfor %}</tbody>{% if report.jours %}<tfoot><tr><th>Total</th><th>{{ report.totaux.tickets }}</th><th>{{ report.totaux.repas }}</th><th>{{ report.totaux.encaisse|number_format(0,',',' ') }}</th><th>{{ report.totaux.subvention|number_format(0,',',' ') }}</th><th>{{ report.totaux.public|number_format(0,',',' ') }}</th><th>{{ report.totaux.repas }}</th><th>{{ report.totaux.encaisse|number_format(0,',',' ') }}</th><th>{{ report.totaux.subvention|number_format(0,',',' ') }}</th></tr></tfoot>{% endif %}</table><h2>Encaissements</h2><table><thead><tr><th>Date</th><th>Ticket</th><th>Employé</th><th>Plat / catégorie</th><th>Mode</th><th>Encaissé</th><th>Subvention</th></tr></thead><tbody>{% for m in report.paiements %}<tr><td>{{ m.date_encaissement }}</td><td>{{ m.numero }}</td><td>{{ m.matricule }} · {{ m.employe_nom }}</td><td>{{ m.plat_servi_nom }} / {{ m.categorie_nom }}</td><td>{{ m.mode_paiement }}</td><td>{{ m.montant }}</td><td>{{ m.subvention }}</td></tr>{% else %}<tr><td colspan="7">Aucun encaissement.</td></tr>{% endfor %}</tbody></table><h2>Tickets délivrés</h2><table><thead><tr><th>Date</th><th>Ticket</th><th>Employé</th><th>Catégorie</th><th>À payer</th><th>Statut</th></tr></thead><tbody>{% for t in report.tickets %}<tr><td>{{ t.date_emission }}</td><td>{{ t.numero }}</td><td>{{ t.matricule }} · {{ t.nom }} {{ t.prenoms }}</td><td>{{ t.categorie_nom }}</td><td>{{ t.prix_employe }}</td><td>{{ t.statut }}</td></tr>{% else %}<tr><td colspan="6">Aucun ticket.</td></tr>{% endfor %}</tbody></table></body></html>
