{% extends 'base.html.twig' %}{% block body %}<h1>Informations de la société</h1><section class="card">{% if societe.logo %}<img class="company-logo" src="{{ path('societe_logo') }}" alt="Logo de la société">{% endif %}<form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('societe') }}"><label>Nom de la société<input name="nom" value="{{ societe.nom }}" maxlength="150" required></label><label>Adresse<textarea name="adresse" maxlength="1000">{{ societe.adresse }}</textarea></label><label>Téléphone<input name="telephone" value="{{ societe.telephone }}" maxlength="50"></label><label>E-mail<input name="email" type="email" value="{{ societe.email }}" maxlength="180"></label><label>Identifiant fiscal / registre<input name="identifiant_fiscal" value="{{ societe.identifiant_fiscal }}" maxlength="100"></label><label>Logo · JPEG, PNG ou WebP · 2 Mo maximum<input name="logo" type="file" accept="image/png,image/jpeg,image/webp"></label><p>Le logo apparaît sur les tickets, les badges et dans l’application mobile. Aucun fichier sélectionné : logo existant conservé.</p><button>Enregistrer la société</button></form></section>{% endblock %}
