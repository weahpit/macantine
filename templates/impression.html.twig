{% extends 'base.html.twig' %}{% block title %}{{ kind == 'ticket' ? item.numero : 'Badge' }} · {{ societe.nom|default('Ma cantine',true) }}{% endblock %}{% block stylesheets %}<link rel="stylesheet" href="{{ app.request.basePath }}/print/{{ format }}.css">{% endblock %}{% block body_class %}print-layout format-{{ format }}{% endblock %}{% block body %}<section class="no-print card print-options"><h2>Format d’impression</h2>{% if kind == 'ticket' %}<a class="button" href="{{ path('imprimer_ticket',{id:item.id,format:'57'}) }}">Ticket 57 mm · mobile/TPE</a> <a class="button" href="{{ path('imprimer_ticket',{id:item.id,format:'80'}) }}">Ticket 80 mm · caisse</a>{% endif %}<p>Imprimer avec Ctrl+P ou le menu du navigateur. Choisir le rouleau correspondant, échelle 100 %, marges nulles, sans en-têtes/pieds de page. La compatibilité Bluetooth/TPE dépend du pilote et de l’application d’impression du terminal.</p></section><section class="print-card card">{% if societe.logo %}<img class="company-logo" src="{{ path('societe_logo') }}" alt="Logo {{ societe.nom }}">{% endif %}<h2>{{ societe.nom|default('MA CANTINE',true) }}</h2>{% if societe.adresse %}<p>{{ societe.adresse }}</p>{% endif %}{% if societe.telephone %}<p>{{ societe.telephone }}</p>{% endif %}<h1>{{ kind == 'badge' ? 'Badge bénéficiaire' : 'Ticket repas' }}</h1><h2>{{ item.nom }} {{ item.prenoms }}</h2><p>{{ item.matricule }} · {{ item.service_nom }}</p>{% if kind == 'ticket' %}<p class="ticket-number">{{ item.numero }}</p><p>{{ item.date_emission|date('d/m/Y') }} · {{ item.statut }}</p><p>{{ item.categorie_nom|default('Catégorie à régulariser',true) }}</p><p><strong>{{ item.prix_employe is not null ? item.prix_employe ~ ' FCFA à payer à la cantine' : 'Tarif à régulariser' }}</strong></p><p>Plat indicatif : {{ item.plat_indicatif_nom|default('Non renseigné',true) }}</p><p>Sans expiration automatique. Utilisation unique.</p>{% endif %}<img class="qr" src="{{ path('qr',{kind:kind,id:item.id}) }}" width="320" height="320" alt="QR Code du {{ kind == 'ticket' ? 'ticket' : 'badge' }}"><p>Service réservé aux travailleurs actifs pendant leurs horaires autorisés.</p>{% if societe.identifiant_fiscal %}<p>{{ societe.identifiant_fiscal }}</p>{% endif %}</section>{% if kind == 'badge' and app.user.role in ['ROLE_ADMIN','ROLE_RH'] %}<section class="card no-print"><form method="post" action="{{ path('badge_renouveler',{id:item.id}) }}"><input name="_token" type="hidden" value="{{ csrf_token('badge_' ~ item.id) }}"><button class="secondary">Renouveler le badge et invalider l’ancien</button></form></section>{% endif %}{% endblock %}
