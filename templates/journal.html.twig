{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">TRAÇABILITÉ</p><h1>Journal des opérations</h1><section class="card"><div class="table"><table><thead><tr><th>Date / heure</th><th>Utilisateur</th><th>Action</th><th>Détail</th></tr></thead><tbody>{% for a in rows %}<tr><td>{{ a.cree_le }}</td><td>{{ a.agent_nom|default('Système') }}</td><td>{{ a.action }}</td><td>{{ a.detail }}</td></tr>{% else %}<tr><td colspan="4">Aucune opération.</td></tr>{% endfor %}</tbody></table></div><div class="pager">{% if page > 1 %}<a href="{{ path('journal',{page:page-1}) }}">Précédent</a>{% endif %}{% if rows|length == 100 %}<a href="{{ path('journal',{page:page+1}) }}">Suivant</a>{% endif %}</div></section>{% endblock %}
