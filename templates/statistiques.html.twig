{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">RH ET COMPTABILITÉ</p><h1>États et exports</h1><section class="card company-head">{% if hasLogo %}<img class="company-logo-left" src="{{ path('societe_logo') }}" alt="Logo de la société">{% endif %}<div><strong>{{ societe.nom|default('MA CANTINE',true) }}</strong>{% if societe.adresse %}<div class="multiline">{{ societe.adresse }}</div>{% endif %}{% if societe.telephone %}<div>Tél. : {{ societe.telephone }}</div>{% endif %}{% if societe.email %}<div>{{ societe.email }}</div>{% endif %}{% if societe.identifiant_fiscal %}<div>{{ societe.identifiant_fiscal }}</div>{% endif %}</div></section><section class="card"><form method="get" class="grid"><label>Du<input name="debut" type="date" value="{{ report.debut }}" required></label><label>Au<input name="fin" type="date" value="{{ report.fin }}" required></label><label>Employé<select name="employe_id"><option value="0">Tous</option>{% for e in employes %}<option value="{{ e.id }}" {% if filtres.employe_id|default(0) == e.id %}selected{% endif %}>{{ e.matricule }} · {{ e.nom }} {{ e.prenoms }}</option>{% endfor %}</select></label><label>Service<select name="service_id"><option value="0">Tous</option>{% for s in services %}<option value="{{ s.id }}" {% if filtres.service_id|default(0) == s.id %}selected{% endif %}>{{ s.nom }}</option>{% endfor %}</select></label><label>Direction<select name="direction_id"><option value="0">Toutes</option>{% for d in directions %}<option value="{{ d.id }}" {% if filtres.direction_id|default(0) == d.id %}selected{% endif %}>{{ d.nom }}</option>{% endfor %}</select></label><label>Catégorie<select name="categorie_id"><option value="0">Toutes</option>{% for c in categories %}<option value="{{ c.id }}" {% if filtres.categorie_id|default(0) == c.id %}selected{% endif %}>{{ c.nom }}</option>{% endfor %}</select></label><button>Calculer</button></form><div class="pager"><a class="button" href="{{ path('export',filtres|merge({format:'pdf',debut:report.debut,fin:report.fin})) }}">Exporter PDF</a><a class="button" href="{{ path('export',filtres|merge({format:'xlsx',debut:report.debut,fin:report.fin})) }}">Exporter Excel</a></div></section><div class="metrics"><section class="card"><span>Tickets délivrés</span><strong>{{ report.totaux.tickets }}</strong></section><section class="card"><span>Repas encaissés</span><strong>{{ report.totaux.repas }}</strong></section><section class="card"><span>Encaissement réel employé</span><strong>{{ report.totaux.encaisse }} F</strong></section><section class="card"><span>Subvention théorique</span><strong>{{ report.totaux.subvention }} F</strong></section></div><p>Tickets filtrés par date de délivrance ; repas et recettes filtrés par date d’encaissement. La subvention est un montant théorique, non un règlement de l’employeur. Les critères service/direction utilisent l’organisation actuelle des employés.</p><section class="card"><h2>Montants par jour et cumul sur la période</h2><div class="table"><table><thead><tr><th>Jour</th><th>Tickets délivrés</th><th>Repas servis</th><th>Encaissé</th><th>Subvention</th><th>Valeur publique</th><th>Cumul repas</th><th>Cumul encaissé</th><th>Cumul subvention</th></tr></thead><tbody>{% for j in report.jours %}<tr><td>{{ j.jour|date('d/m/Y') }}</td><td>{{ j.tickets_delivres }}</td><td>{{ j.repas_servis }}</td><td>{{ j.encaisse_fcfa|number_format(0,',',' ') }} F</td><td>{{ j.subvention_fcfa|number_format(0,',',' ') }} F</td><td>{{ j.valeur_publique_fcfa|number_format(0,',',' ') }} F</td><td>{{ j.cumul_repas }}</td><td><strong>{{ j.cumul_encaisse_fcfa|number_format(0,',',' ') }} F</strong></td><td>{{ j.cumul_subvention_fcfa|number_format(0,',',' ') }} F</td></tr>{% else %}<tr><td colspan="9">Aucune activité sur la période.</td></tr>{% endfor %}</tbody>{% if report.jours %}<tfoot><tr><th>Total période</th><th>{{ report.totaux.tickets }}</th><th>{{ report.totaux.repas }}</th><th>{{ report.totaux.encaisse|number_format(0,',',' ') }} F</th><th>{{ report.totaux.subvention|number_format(0,',',' ') }} F</th><th>{{ report.totaux.public|number_format(0,',',' ') }} F</th><th>{{ report.totaux.repas }}</th><th>{{ report.totaux.encaisse|number_format(0,',',' ') }} F</th><th>{{ report.totaux.subvention|number_format(0,',',' ') }} F</th></tr></tfoot>{% endif %}</table></div><p class="muted">Seuls les jours avec au moins un ticket délivré ou un repas encaissé sont listés.</p></section><section class="card"><h2>Encaissements — valeur publique {{ report.totaux.public }} F</h2><div class="table"><table><tr><th>Date</th><th>Employé / ticket</th><th>Plat / catégorie</th><th>Mode</th><th>Encaissé</th><th>Subvention</th></tr>{% for m in report.paiements %}<tr><td>{{ m.date_encaissement }}</td><td>{{ m.matricule }} · {{ m.employe_nom }}<br>{{ m.numero }}</td><td>{{ m.plat_servi_nom }}<br>{{ m.categorie_nom }}</td><td>{{ m.mode_paiement }}</td><td>{{ m.montant }} F</td><td>{{ m.subvention }} F</td></tr>{% else %}<tr><td colspan="6">Aucun encaissement.</td></tr>{% endfor %}</table></div></section><section class="card"><h2>Tickets délivrés sur la période</h2><div class="table"><table><tr><th>Date</th><th>Employé</th><th>Numéro</th><th>Catégorie</th><th>À payer</th><th>Statut</th></tr>{% for t in report.tickets %}<tr><td>{{ t.date_emission }}</td><td>{{ t.matricule }} · {{ t.nom }} {{ t.prenoms }}</td><td>{{ t.numero }}</td><td>{{ t.categorie_nom }}</td><td>{{ t.prix_employe }} F</td><td>{{ t.statut }}</td></tr>{% else %}<tr><td colspan="6">Aucun ticket délivré.</td></tr>{% endfor %}</table></div></section>{% endblock %}
