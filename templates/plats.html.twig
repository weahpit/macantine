{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">OFFRE ET SUBVENTIONS</p><h1>Plats et grille tarifaire</h1><p>Les nouveaux tarifs s’appliquent aux nouveaux tickets. Les tickets existants gardent leurs montants.</p><section class="card"><h2>{{ edit ? 'Modifier le plat' : 'Ajouter un plat' }}</h2><form method="post" enctype="multipart/form-data" class="grid"><input name="_token" type="hidden" value="{{ csrf_token('plats') }}"><input name="nature" type="hidden" value="plat"><input name="id" type="hidden" value="{{ edit ? edit.id : 0 }}"><label>Nom<input name="nom" value="{{ edit ? edit.nom : '' }}" maxlength="150" required></label><label>Catégorie<select name="categorie_id">{% for c in categories %}<option value="{{ c.id }}" {% if edit and edit.categorie_id == c.id %}selected{% endif %}>{{ c.nom }}</option>{% endfor %}</select></label><label>Description<textarea name="description" maxlength="3000">{{ edit ? edit.description : '' }}</textarea></label><label>Photo (JPEG, PNG, WebP · 5 Mo max)<input name="photo" type="file" accept="image/jpeg,image/png,image/webp"></label><label class="check"><input name="actif" type="checkbox" value="1" {% if not edit or edit.actif %}checked{% endif %}>Actif</label><button>Enregistrer le plat</button></form></section><div class="dish-grid">{% for p in plats %}<div>{% include '_plat.html.twig' with {p:p} %}<p><a href="{{ path('plats',{modifier:p.id}) }}">Modifier {{ p.nom }}</a> · {{ p.actif ? 'Actif' : 'Inactif' }}</p></div>{% endfor %}</div><section class="card"><h2>Catégories tarifaires — FCFA</h2>{% for c in categories %}<form method="post" class="grid"><input name="_token" type="hidden" value="{{ csrf_token('plats') }}"><input name="nature" type="hidden" value="categorie"><input name="id" type="hidden" value="{{ c.id }}"><label>Nom<input name="nom" value="{{ c.nom }}" required></label><label>Prix public<input name="prix_public" type="number" min="0" value="{{ c.prix_public }}" required></label><label>Prix employé<input name="prix_employe" type="number" min="0" value="{{ c.prix_employe }}" required></label><label class="check"><input name="actif" type="checkbox" value="1" {% if c.actif %}checked{% endif %}>Actif</label><button>Mettre à jour</button></form>{% endfor %}<h3>Nouvelle catégorie</h3><form method="post" class="grid"><input name="_token" type="hidden" value="{{ csrf_token('plats') }}"><input name="nature" type="hidden" value="categorie"><label>Nom<input name="nom" required></label><label>Prix public<input name="prix_public" type="number" min="0" required></label><label>Prix employé<input name="prix_employe" type="number" min="0" required></label><input name="actif" type="hidden" value="1"><button>Ajouter</button></form></section>{% endblock %}
