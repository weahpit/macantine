{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">BÉNÉFICIAIRES</p><h1>Employés</h1><section class="card"><h2>{{ edit ? 'Modifier l’employé' : 'Ajouter un employé' }}</h2><form method="post" class="grid"><input type="hidden" name="_token" value="{{ csrf_token('employe') }}"><input type="hidden" name="id" value="{{ edit ? edit.id : 0 }}"><label>Matricule<input name="matricule" maxlength="50" value="{{ edit ? edit.matricule : '' }}" required></label><label>Nom<input name="nom" maxlength="100" value="{{ edit ? edit.nom : '' }}" required></label><label>Prénoms<input name="prenoms" maxlength="150" value="{{ edit ? edit.prenoms : '' }}" required></label><label>Téléphone (application mobile)<input name="telephone" type="tel" inputmode="tel" maxlength="25" value="{{ edit ? edit.telephone : '' }}" placeholder="07 00 00 00 00" autocomplete="off"></label><label>Service<select name="service_id" required><option value="">Choisir</option>{% for s in services %}<option value="{{ s.id }}" {% if edit and edit.service_id == s.id %}selected{% endif %}>{{ s.direction_nom }} · {{ s.nom }}</option>{% endfor %}</select></label><label class="check"><input name="actif" type="checkbox" value="1" {% if not edit or edit.actif %}checked{% endif %}>Employé actif</label><button>Enregistrer</button></form>{% if services is empty %}<p>Créez d’abord une direction et un service dans les paramètres.</p>{% endif %}</section><section class="card"><h2>Liste des bénéficiaires</h2><form method="get" class="filters"><label>Rechercher un employé<input name="q" value="{{ q }}" placeholder="Matricule, nom ou prénoms"></label><button>Rechercher</button></form><div class="table"><table><thead><tr><th>Matricule</th><th>Employé</th><th>Direction / service</th><th>Téléphone / accès mobile</th><th>Statut</th><th>Actions</th></tr></thead><tbody>{% for e in employes %}<tr><td>{{ e.matricule }}</td><td>{{ e.nom }} {{ e.prenoms }}</td><td>{{ e.direction_nom }} / {{ e.service_nom }}</td><td>{{ e.telephone|default('—',true) }}<br><span class="status">{{ e.pin_defini ? 'PIN défini' : 'Pas de PIN' }}</span><details class="pin"><summary>Gérer le PIN</summary><form method="post" action="{{ path('employe_pin',{id:e.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('pin_' ~ e.id) }}"><input type="hidden" name="nature" value="definir"><label>PIN à 4 chiffres (vide = généré)<input name="pin" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off"></label><button class="secondary">{{ e.pin_defini ? 'Nouveau PIN' : 'Définir le PIN' }}</button></form>{% if e.pin_defini %}<form method="post" action="{{ path('employe_pin',{id:e.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('pin_' ~ e.id) }}"><input type="hidden" name="nature" value="retirer"><button class="secondary">Retirer l’accès mobile</button></form>{% endif %}</details></td><td>{{ e.actif ? 'Actif' : 'Inactif' }}</td><td><a href="{{ path('employes',{modifier:e.id}) }}">Modifier</a> · <a href="{{ path('badge',{id:e.id}) }}">Badge</a></td></tr>{% else %}<tr><td colspan="6">Aucun employé enregistré.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
