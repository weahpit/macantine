{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">ACCÈS ET PERMISSIONS</p><h1>Utilisateurs</h1><section class="card"><h2>{{ edit ? 'Modifier le compte' : 'Créer un compte' }}</h2><form method="post" class="grid"><input name="_token" type="hidden" value="{{ csrf_token('utilisateur') }}"><input name="id" type="hidden" value="{{ edit ? edit.id : 0 }}"><label>Nom affiché<input name="nom" maxlength="150" value="{{ edit ? edit.nom : '' }}" required></label><label>E-mail<input name="email" type="email" maxlength="180" value="{{ edit ? edit.email : '' }}" required></label><label>Profil<select name="role">{% for value,label in {'ROLE_ADMIN':'Administrateur','ROLE_RH':'RH','ROLE_CANTINE':'Restaurant / cantine','ROLE_COMPTABILITE':'Comptabilité','ROLE_EMPLOYE':'Employé'} %}<option value="{{ value }}" {% if edit and edit.role == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><label>Employé associé<select name="employe_id"><option value="0">Aucun — sauf profil Employé</option>{% for e in employes %}<option value="{{ e.id }}" {% if edit and edit.employe_id == e.id %}selected{% endif %}>{{ e.matricule }} · {{ e.nom }} {{ e.prenoms }}</option>{% endfor %}</select></label><label>Mot de passe<input name="mot_de_passe" type="password" minlength="12" autocomplete="new-password" {% if not edit %}required{% endif %}><small>{{ edit ? 'Laisser vide pour conserver le mot de passe.' : '12 caractères minimum.' }}</small></label><label class="check"><input name="actif" type="checkbox" value="1" {% if not edit or edit.actif %}checked{% endif %}>Compte actif</label><button>Enregistrer</button></form></section><section class="card"><div class="table"><table><thead><tr><th>Nom</th><th>E-mail</th><th>Profil</th><th>Statut</th><th>Action</th></tr></thead><tbody>{% for u in users %}<tr><td>{{ u.nom }}</td><td>{{ u.email }}</td><td>{{ u.role }}</td><td>{{ u.actif ? 'Actif' : 'Inactif' }}</td><td><a href="{{ path('utilisateurs',{modifier:u.id}) }}">Modifier</a></td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
