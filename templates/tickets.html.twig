{% extends 'base.html.twig' %}{% block body %}<p class="eyebrow">DROITS DURABLES AUX REPAS</p><h1>{{ app.user.role == 'ROLE_EMPLOYE' ? 'Mes tickets' : 'Tickets' }}</h1><p>Un ticket délivré par employé et par jour. Les tickets non consommés se cumulent et restent valables sans expiration automatique. Le plat est indicatif ; la catégorie et les prix sont figés à la délivrance.</p>{% if app.user.role in ['ROLE_ADMIN','ROLE_RH'] %}<details class="card issuance" id="delivrer-ticket" open><summary>Délivrer un ticket — choisir un plat</summary><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('emission') }}"><label>Employé<select name="employe_id" required><option value="">Sélectionner</option>{% for e in employes %}{% if e.actif %}<option value="{{ e.id }}">{{ e.matricule }} · {{ e.nom }} {{ e.prenoms }}</option>{% endif %}{% endfor %}</select></label><h3>Plats du jour · {{ today|date('d/m/Y') }}</h3><div class="dish-grid">{% for p in platsJour %}{% include '_choix_plat.html.twig' with {p:p} %}{% else %}<p>Aucun plat programmé aujourd’hui. Consultez les autres plats actifs ou faites configurer le menu.</p>{% endfor %}</div><details><summary>Autres plats actifs (choix indicatif)</summary><div class="dish-grid">{% set dayIds = platsJour|map(p => p.id) %}{% for p in plats %}{% if p.id not in dayIds %}{% include '_choix_plat.html.twig' with {p:p} %}{% endif %}{% endfor %}</div></details><button>Délivrer le ticket sans encaisser</button></form></details>{% endif %}<section class="card"><form method="get" class="filters"><label>Recherche<input name="q" value="{{ q }}" placeholder="Numéro, matricule ou nom"></label><label>Statut<select name="statut"><option value="">Tous</option>{% for s in ['DISPONIBLE','UTILISE','ANNULE'] %}<option value="{{ s }}" {% if statut == s %}selected{% endif %}>{{ s }}</option>{% endfor %}</select></label><button>Filtrer</button></form><p>{{ total }} ticket(s) · Page {{ page }}</p><div class="table"><table><thead><tr><th>Ticket / délivrance</th><th>Employé</th><th>Catégorie / plat indicatif</th><th>À payer</th><th>Statut / actions</th></tr></thead><tbody>{% for t in tickets %}<tr><td>{{ t.numero }}<br>{{ t.date_emission|date('d/m/Y') }}<br><a href="{{ path('imprimer_ticket',{id:t.id}) }}">Afficher / imprimer</a></td><td>{{ t.matricule }}<br>{{ t.nom }} {{ t.prenoms }}</td><td>{{ t.categorie_nom|default('À régulariser',true) }}<br>{{ t.plat_indicatif_nom|default('—',true) }}</td><td>{{ t.prix_employe is not null ? t.prix_employe ~ ' F' : 'Non défini' }}</td><td><span class="status">{{ t.statut }}</span>{% if app.user.role in ['ROLE_ADMIN','ROLE_RH'] %}{% if t.statut in ['DISPONIBLE','ANNULE'] %}<form method="post" action="{{ path('ticket_action',{id:t.id,action:t.statut == 'ANNULE' ? 'reactiver' : 'annuler'}) }}"><input name="_token" type="hidden" value="{{ csrf_token('ticket_' ~ t.id) }}"><button class="secondary">{{ t.statut == 'ANNULE' ? 'Réactiver' : 'Annuler' }}</button></form>{% endif %}{% if t.statut == 'DISPONIBLE' and not t.categorie_id %}<form method="post" action="{{ path('ticket_action',{id:t.id,action:'regulariser'}) }}"><input name="_token" type="hidden" value="{{ csrf_token('ticket_' ~ t.id) }}"><label>Catégorie historique<select name="categorie_id">{% for cat in categories %}{% if cat.actif %}<option value="{{ cat.id }}">{{ cat.nom }}</option>{% endif %}{% endfor %}</select></label><button class="secondary">Régulariser</button></form>{% endif %}{% endif %}</td></tr>{% else %}<tr><td colspan="5">Aucun ticket.</td></tr>{% endfor %}</tbody></table></div><div class="pager">{% if page > 1 %}<a href="{{ path('tickets',{q:q,statut:statut,page:page-1}) }}">Précédent</a>{% endif %}{% if page*50 < total %}<a href="{{ path('tickets',{q:q,statut:statut,page:page+1}) }}">Suivant</a>{% endif %}</div></section>{% endblock %}
