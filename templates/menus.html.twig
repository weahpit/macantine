{% extends 'base.html.twig' %}{% set jours = {1:'Lundi',2:'Mardi',3:'Mercredi',4:'Jeudi',5:'Vendredi',6:'Samedi',7:'Dimanche'} %}{% block body %}<p class="eyebrow">RESTAURATION</p><h1>Menus programmés</h1><section class="card"><form method="get" class="filters"><label>Date<input type="date" name="date" value="{{ date }}" required></label><button>Afficher</button></form></section><div class="dish-grid">{% for p in menu %}{% include '_plat.html.twig' with {p:p} %}{% else %}<section class="card">Aucun plat programmé pour cette date.</section>{% endfor %}</div><section class="card"><h2>Programme hebdomadaire</h2><div class="table"><table><tr><th>Jour</th><th>Plat</th><th>Catégorie</th></tr>{% for row in programme %}<tr><td>{{ jours[row.jour] }}</td><td>{{ row.nom }}</td><td>{{ row.categorie_nom }}</td></tr>{% else %}<tr><td colspan="3">Programme à configurer.</td></tr>{% endfor %}</table></div></section>{% if app.user.role in ['ROLE_ADMIN','ROLE_CANTINE'] %}<div class="two"><section class="card"><h2>Remplacer le menu d’un jour de semaine</h2><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('menus') }}"><input name="nature" type="hidden" value="semaine"><label>Jour<select name="jour">{% for n,jour in jours %}<option value="{{ n }}">{{ jour }}</option>{% endfor %}</select></label>{% for p in plats %}<label class="check"><input type="checkbox" name="plats[]" value="{{ p.id }}">{{ p.nom }} · {{ p.categorie_nom }}</label>{% endfor %}<button>Remplacer le programme du jour</button></form></section><section class="card"><h2>Exception pour une date précise</h2><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('menus') }}"><input name="nature" type="hidden" value="date"><label>Date<input type="date" name="date_menu" value="{{ date }}" required></label>{% for p in plats %}<label class="check"><input type="checkbox" name="plats[]" value="{{ p.id }}">{{ p.nom }}</label>{% endfor %}<button>Remplacer le menu de cette date</button></form><form method="post"><input name="_token" type="hidden" value="{{ csrf_token('menus') }}"><input name="nature" type="hidden" value="retablir"><input name="date_menu" type="hidden" value="{{ date }}"><button class="secondary">Rétablir le programme hebdomadaire pour {{ date }}</button></form></section></div>{% endif %}{% endblock %}
