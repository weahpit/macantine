{
  "name": "entreprise/cantine",
  "description": "Gestion autonome de cantine : tickets et badges",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4.1 <9.0",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "ext-gd": "*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/security-csrf": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/yaml": "8.1.*",
    "symfony/rate-limiter": "8.1.*",
    "doctrine/dbal": "^4.3",
    "endroid/qr-code": "~6.1.0",
    "ext-mbstring": "*",
    "ext-pdo_pgsql": "*",
    "dompdf/dompdf": "^3.1",
    "phpoffice/phpspreadsheet": "^5.0",
    "ext-fileinfo": "*",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    }
  },
  "require-dev": {
    "symfony/maker-bundle": "^1.68",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/dom-crawler": "8.1.*",
    "symfony/process": "8.1.*"
  }
}
